<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent" android:layout_height="match_parent"
    android:orientation="vertical" android:background="@drawable/bg_gradient"
    android:paddingLeft="56dp" android:paddingRight="56dp" android:paddingTop="18dp">

    <!-- header: tabs + clock -->
    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="horizontal" android:gravity="center_vertical">
        <TextView android:id="@+id/tabForYou" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="For you"
            android:textSize="20sp" android:textColor="@color/tab_text" android:background="@drawable/tab_bg" android:paddingLeft="22dp" android:paddingRight="22dp" android:paddingTop="8dp" android:paddingBottom="8dp" android:focusable="true" android:focusableInTouchMode="true" android:nextFocusDown="@+id/heroRow" />
        <TextView android:id="@+id/tabFootball" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="Sport" android:layout_marginLeft="6dp"
            android:textSize="20sp" android:textColor="@color/tab_text" android:background="@drawable/tab_bg" android:paddingLeft="22dp" android:paddingRight="22dp" android:paddingTop="8dp" android:paddingBottom="8dp" android:focusable="true" android:focusableInTouchMode="true" />
        <TextView android:id="@+id/tabApps" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="Apps" android:layout_marginLeft="6dp"
            android:textSize="20sp" android:textColor="@color/tab_text" android:background="@drawable/tab_bg" android:paddingLeft="22dp" android:paddingRight="22dp" android:paddingTop="8dp" android:paddingBottom="8dp" android:focusable="true" android:focusableInTouchMode="true" />
        <View android:layout_width="0dp" android:layout_weight="1" android:layout_height="1dp" />
        <TextView android:id="@+id/greeting" android:layout_width="wrap_content" android:layout_height="wrap_content" android:textSize="18sp" android:textColor="@color/muted" android:layout_marginRight="18dp" />
        <TextView android:id="@+id/clock" android:layout_width="wrap_content" android:layout_height="wrap_content" android:textSize="22sp" android:textColor="@color/text" />
    </LinearLayout>

    <!-- kick-off / live banner -->
    <LinearLayout android:id="@+id/alert" android:layout_width="match_parent" android:layout_height="wrap_content"
        android:layout_marginTop="14dp" android:orientation="horizontal" android:gravity="center_vertical"
        android:background="@drawable/banner_bg" android:padding="12dp" android:focusable="true" android:focusableInTouchMode="true" android:visibility="gone">
        <TextView android:id="@+id/alertText" android:layout_width="0dp" android:layout_weight="1" android:layout_height="wrap_content" android:textSize="18sp" android:textColor="#1A1917" android:textStyle="bold" />
        <TextView android:id="@+id/alertHint" android:layout_width="wrap_content" android:layout_height="wrap_content" android:textSize="14sp" android:textColor="#1A1917" android:text="Select to open" />
    </LinearLayout>

    <!-- content area -->
    <FrameLayout android:layout_width="match_parent" android:layout_height="0dp" android:layout_weight="1" android:layout_marginTop="10dp">

        <!-- FOR YOU: posters + football (match days) -->
        <LinearLayout android:id="@+id/pageForYou" android:layout_width="match_parent" android:layout_height="match_parent" android:orientation="vertical" android:gravity="center_vertical">
            <TextView android:id="@+id/heroTitle" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="Tonight" android:textSize="14sp" android:textColor="@color/muted" />
            <HorizontalScrollView android:id="@+id/heroScroll" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="8dp" android:scrollbars="none" android:clipToPadding="false" android:paddingTop="8dp" android:paddingBottom="8dp" android:clipChildren="false">
                <LinearLayout android:id="@+id/heroRow" android:layout_width="wrap_content" android:layout_height="wrap_content" android:orientation="horizontal" android:clipChildren="false" />
            </HorizontalScrollView>
            <TextView android:id="@+id/footballTitle" android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginTop="14dp" android:text="Sport today" android:textSize="14sp" android:textColor="@color/muted" />
            <HorizontalScrollView android:id="@+id/footballScroll" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="6dp" android:scrollbars="none" android:clipToPadding="false" android:paddingTop="6dp" android:paddingBottom="6dp" android:clipChildren="false">
                <LinearLayout android:id="@+id/footballRow" android:layout_width="wrap_content" android:layout_height="wrap_content" android:orientation="horizontal" android:clipChildren="false" />
            </HorizontalScrollView>
        </LinearLayout>

        <!-- FOOTBALL tab: same row, bigger context -->
        <LinearLayout android:id="@+id/pageFootball" android:layout_width="match_parent" android:layout_height="match_parent" android:orientation="vertical" android:gravity="center_vertical" android:visibility="gone">
            <TextView android:id="@+id/footballTitle2" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="Sport" android:textSize="14sp" android:textColor="@color/muted" />
            <HorizontalScrollView android:id="@+id/footballScroll2" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="8dp" android:scrollbars="none" android:clipToPadding="false" android:paddingTop="8dp" android:paddingBottom="8dp" android:clipChildren="false">
                <LinearLayout android:id="@+id/footballRow2" android:layout_width="wrap_content" android:layout_height="wrap_content" android:orientation="horizontal" android:clipChildren="false" />
            </HorizontalScrollView>
            <TextView android:id="@+id/footballNote" android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginTop="12dp" android:textSize="13sp" android:textColor="@color/muted" android:text="Football and India cricket. List updates every morning at 06:46. Select a match to open the app; the VPN switches by itself." />
        </LinearLayout>

        <!-- APPS tab -->
        <GridView android:id="@+id/grid" android:layout_width="match_parent" android:layout_height="match_parent" android:visibility="gone"
            android:numColumns="7" android:horizontalSpacing="10dp" android:verticalSpacing="10dp" android:clipToPadding="false" android:paddingTop="8dp" android:paddingBottom="24dp" android:listSelector="@android:color/transparent" />
    </FrameLayout>

    <!-- dock -->
    <HorizontalScrollView android:id="@+id/dockScroll" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginBottom="14dp" android:scrollbars="none" android:clipToPadding="false" android:paddingTop="8dp" android:paddingBottom="8dp" android:clipChildren="false">
        <LinearLayout android:id="@+id/dockRow" android:layout_width="wrap_content" android:layout_height="wrap_content" android:orientation="horizontal" android:clipChildren="false" />
    </HorizontalScrollView>
</LinearLayout>
