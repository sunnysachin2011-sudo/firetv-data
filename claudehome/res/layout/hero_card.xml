<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="212dp" android:layout_height="119dp" android:layout_marginRight="16dp"
    android:orientation="vertical" android:gravity="bottom" android:background="@drawable/card_glass"
    android:focusable="true" android:focusableInTouchMode="true" android:padding="12dp">
    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="horizontal" android:gravity="center_vertical">
        <View android:id="@+id/cDot" android:layout_width="8dp" android:layout_height="8dp" android:layout_marginRight="6dp" android:background="@drawable/live_dot" android:visibility="gone" />
        <TextView android:id="@+id/cTop" android:layout_width="0dp" android:layout_weight="1" android:layout_height="wrap_content" android:textSize="12sp" android:textColor="#C8FFFFFF" android:singleLine="true" />
        <TextView android:id="@+id/cStar" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="★" android:textSize="13sp" android:textColor="#FFFFD36B" android:visibility="gone" />
    </LinearLayout>
    <TextView android:id="@+id/cTitle" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="4dp" android:textSize="16sp" android:textColor="#FFFFFFFF" android:maxLines="2" android:ellipsize="end" />
    <TextView android:id="@+id/cSub" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="2dp" android:textSize="12sp" android:textColor="#B3FFFFFF" android:singleLine="true" android:ellipsize="end" />
</LinearLayout>
