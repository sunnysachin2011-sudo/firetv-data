<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent" android:layout_height="match_parent"
    android:orientation="vertical" android:background="@color/bg"
    android:paddingLeft="48dp" android:paddingRight="48dp" android:paddingTop="22dp">
    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="horizontal">
        <TextView android:id="@+id/greeting" android:layout_width="0dp" android:layout_weight="1" android:layout_height="wrap_content"
            android:textSize="26sp" android:textColor="@color/text" android:text="Claude Home" />
        <TextView android:id="@+id/clock" android:layout_width="wrap_content" android:layout_height="wrap_content"
            android:textSize="26sp" android:textColor="@color/muted" />
    </LinearLayout>
    <TextView android:id="@+id/footballTitle" android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginTop="10dp"
        android:text="Football today" android:textSize="13sp" android:textColor="@color/muted" />
    <HorizontalScrollView android:id="@+id/footballScroll" android:layout_width="match_parent" android:layout_height="wrap_content"
        android:layout_marginTop="4dp" android:scrollbars="none" android:clipToPadding="false" android:paddingBottom="4dp" android:paddingTop="4dp">
        <LinearLayout android:id="@+id/footballRow" android:layout_width="wrap_content" android:layout_height="wrap_content" android:orientation="horizontal" />
    </HorizontalScrollView>
    <TextView android:id="@+id/forYouTitle" android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginTop="6dp"
        android:text="For you" android:textSize="13sp" android:textColor="@color/muted" />
    <HorizontalScrollView android:id="@+id/forYouScroll" android:layout_width="match_parent" android:layout_height="wrap_content"
        android:layout_marginTop="4dp" android:scrollbars="none" android:clipToPadding="false" android:paddingBottom="4dp" android:paddingTop="4dp">
        <LinearLayout android:id="@+id/forYouRow" android:layout_width="wrap_content" android:layout_height="wrap_content" android:orientation="horizontal" />
    </HorizontalScrollView>
    <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginTop="6dp"
        android:text="All apps" android:textSize="13sp" android:textColor="@color/muted" />
    <GridView android:id="@+id/grid" android:layout_width="match_parent" android:layout_height="0dp" android:layout_weight="1"
        android:layout_marginTop="4dp" android:numColumns="7" android:horizontalSpacing="10dp" android:verticalSpacing="10dp"
        android:clipToPadding="false" android:paddingBottom="24dp" android:paddingTop="6dp" android:listSelector="@android:color/transparent" />
</LinearLayout>
