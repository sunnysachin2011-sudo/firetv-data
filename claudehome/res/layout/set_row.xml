<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical" android:layout_marginTop="22dp">
    <TextView android:id="@+id/rowLabel" android:layout_width="wrap_content" android:layout_height="wrap_content"
        android:textSize="12sp" android:letterSpacing="0.15" android:textAllCaps="true" android:textColor="#FF9FC1FF" />
    <LinearLayout android:id="@+id/rowChips" android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="horizontal"
        android:layout_marginTop="10dp" android:clipChildren="false" android:clipToPadding="false" />
</LinearLayout>
